programa {
  funcao inicio() {
   //entendimento do problema
    //calcular o valor de vale trocas, considerando preço e quantidade 
    // infos e variaveis
    real valeTroca, preco
    inteiro quantidade
    //entrada de dados
escreva("qual o preço desse par de calçado? ")
leia(preco)
escreva("quantidade de calçados? ")
leia(quantidade)

    //processamento
    valeTroca = preco * quantidade
   // saida 
   escreva(valeTroca)
   

  }

}
