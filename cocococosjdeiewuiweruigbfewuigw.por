programa {
  funcao inicio() {
    //entendimento dos problems
    //calcular quantidade de laranjas foram vendidas
    //informations and whatever
    inteiro laranjas1, laranjas2, laranjasvendidas
    //entrada di laranja
    escreva("quantidade inicial de laranjas: ")
    leia(laranjas1)
    escreva("quantidade final de laranjas")
    leia(laranjas2)
    //processamentos
    laranjas vendidas = laranjas1 - laranjas1
    //sabor 42    
    escreva("quantidade final de laranjas: " + laranjasvendidas)
  }
}
